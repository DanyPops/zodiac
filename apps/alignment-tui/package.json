{
  "name": "@alignment/tui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "alignment-tui": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --external:@earendil-works/* --external:typescript --external:jsonc-parser --banner:js=\"import{createRequire as __createRequire}from 'module';const require=__createRequire(import.meta.url);\" --outfile=dist/cli.js"
  },
  "dependencies": {
    "@alignment/core": "*",
    "@alignment/pi-integration": "*",
    "@alignment/surface-protocol": "*",
    "@danypops/alignment-lector": "file:vendor/danypops-alignment-lector-0.0.2.tgz",
    "@danypops/pi-lector": "file:vendor/danypops-pi-lector-0.12.9.tgz",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.0"
  },
  "devDependencies": {
    "@danypops/lector": "file:vendor/danypops-lector-0.18.15.tgz",
    "@danypops/pi-tui-harness": "^0.0.2",
    "@danypops/vehicle-server": "^0.3.2",
    "@types/picomatch": "^4.0.3",
    "@xterm/headless": "^6.0.0",
    "esbuild": "^0.28.1",
    "node-pty": "^1.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
