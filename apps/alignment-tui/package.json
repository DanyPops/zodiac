{
  "name": "@alignment/tui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": { "alignment-tui": "./dist/cli.js" },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
