  },
  "dependencies": {
    "@alignment/surface-protocol": "*",
    "@earendil-works/pi-tui": "^0.84.0"
  },
  "devDependencies": {
    "@alignment/core": "*",
    "@danypops/pi-tui-harness": "^0.0.2",
    "esbuild": "^0.28.1",
    "node-pty": "^1.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
