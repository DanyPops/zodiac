{
  "name": "@zodiac/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-dev-port.mjs && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:system": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-strategy content --cache-location .eslintcache .",
    "lint:ci": "eslint --max-warnings 0 .",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "verify": "npm run typecheck && npm run lint:ci && npm test && npm run build && npm run check:bundle-budget && npm run test:system"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@zodiac/server": "*",
    "@zodiac/agent": "*",
    "@icons-pack/react-simple-icons": "^13.11.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-hotkeys": "^0.10.0",
    "dockview-react": "^7.0.4",
    "lucide-react": "^1.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0"
  }
}
